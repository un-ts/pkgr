{
  "name": "@unts/pkgr",
  "version": "0.0.0",
  "type": "module",
  "description": "Simple but incredible utilities for package bundlers like rollup",
  "repository": "https://github.com/un-ts/pkgr.git",
  "homepage": "https://pkgr.1stG.me",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "run-s build:ts build:r",
    "build:r": "yarn r -f cjs -d false -e named --esbuild '{target:es2022}'",
    "build:ts": "tsc -b",
    "clean": "rimraf -g .type-coverage coverage dist '.*cache' 'packages/*/{lib,*.tsbuildinfo}'",
    "docs": "vite",
    "docs:build": "vite build",
    "format": "prettier --write .",
    "lint": "run-p 'lint:*'",
    "lint:es": "eslint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "simple-git-hooks && yarn-berry-deduplicate || exit 0",
    "r": "tsx packages/rollup/src/cli.ts",
    "release": "changeset publish",
    "test": "vitest run",
    "typecov": "type-coverage",
    "version": "changeset version && yarn --no-immutable"
  },
  "devDependencies": {
    "@1stg/common-config": "^15.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@swc/core": "^1.16.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/debug": "^4.1.13",
    "@types/imagemin": "^9.0.1",
    "@types/is-glob": "^4.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web": "^0.0.355",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.8.1",
    "github-markdown-css": "^5.9.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "rehype-slug": "^6.0.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.12",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.0",
    "vue": "^3.5.41",
    "yarn-berry-deduplicate": "^6.1.3"
  },
  "resolutions": {
    "prettier": "^3.5.3"
  },
  "commitlint": {
    "extends": [
      "@1stg"
    ]
  },
  "prettier": "@1stg/prettier-config",
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreNonNullAssertion": true,
    "ignoreCatch": true,
    "ignoreFiles": [
      "*.d.ts"
    ],
    "ignoreNested": true,
    "strict": true,
    "update": true
  }
}
